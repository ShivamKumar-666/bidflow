# BidFlow Backend — Environment Variables
# ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Usage: python-dotenv loads .env automatically when app.py starts.

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_secrets.token_hex(32)

FLASK_ENV=development    # set to 'production' for Gunicorn deployment

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_use_secrets.token_hex(32)

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Option A — Full URI (takes precedence over individual fields below)
# MONGO_URI=mongodb://username:password@host:27017/bidflow?authSource=admin

# Option B — Individual fields (used only if MONGO_URI is not set)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=bidflow
# Leave blank for unauthenticated local dev:
MONGO_USERNAME=
MONGO_PASSWORD=

# ── Rate Limiter ─────────────────────────────────────────────────────────────
# Defaults to in-memory storage. For production, use Redis:
# LIMITER_STORAGE_URI=redis://localhost:6379/0

# ── Gunicorn (production only) ───────────────────────────────────────────────
PORT=5000
GUNICORN_WORKERS=1
LOG_LEVEL=info

# ── Email (Gmail App Password recommended for dev) ───────────────────────────
# Use Mailtrap for development or your preferred SMTP provider (SendGrid, SES, etc.)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── Email Verification Token & URLs ──────────────────────────────────────────
EMAIL_TOKEN_SECRET=CHANGE_ME_use_secrets.token_hex(32)
FRONTEND_URL=http://localhost:5173

