# BidFlow Backend — Docker Environment Variables
# ────────────────────────────────────────────────
# Copy this file to .env and fill in your values for Docker deployment.
# NEVER commit .env to version control.

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_use_secrets.token_hex(32)
FLASK_ENV=production

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_use_secrets.token_hex(32)

# ── MongoDB ───────────────────────────────────────────────────────────────────
# In Docker, the MongoDB service is named "mongodb" (see docker-compose.yml)
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=bidflow
MONGO_USERNAME=
MONGO_PASSWORD=

# ── Gunicorn ──────────────────────────────────────────────────────────────────
PORT=5000
GUNICORN_WORKERS=1
LOG_LEVEL=info

# ── Email ─────────────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── Email Verification ────────────────────────────────────────────────────────
EMAIL_TOKEN_SECRET=CHANGE_ME_use_secrets.token_hex(32)
FRONTEND_URL=http://localhost

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
